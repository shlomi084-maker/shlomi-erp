# Copy to .env and fill in. ".env" is gitignored and never leaves this machine.
# The scripts in scripts/ read these values. n8n itself keeps the real secrets
# (Gemini API key, Telegram bot tokens, Google OAuth) in its own credential store.

# --- n8n -------------------------------------------------------------------
# Instance URL: http://localhost:5678 for the Docker setup, the tunnel URL, or https://<name>.app.n8n.cloud
N8N_URL=
# Settings -> n8n API -> Create an API key
N8N_API_KEY=

# --- Airtable --------------------------------------------------------------
# Personal access token with scopes: data.records:read, data.records:write,
# schema.bases:read, schema.bases:write  (on the ERP base only)
AIRTABLE_PAT=
# The base id from the URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=

# --- Owner -----------------------------------------------------------------
# Your Telegram chat id (send a message to the manager bot, then open
# https://api.telegram.org/bot<MANAGER_BOT_TOKEN>/getUpdates and copy "chat":{"id":...})
OWNER_TELEGRAM_CHAT_ID=
# The Gmail address connected in n8n. Lead-alert emails go here, and demo leads use
# plus-addressing (you+lead-dana@gmail.com) so cold emails land in this inbox.
OWNER_EMAIL=

# --- n8n credential IDs ----------------------------------------------------
# Create the 6 credentials in n8n (Google Gemini, Airtable, 2x Telegram, Gmail, Drive) (Credentials -> Add), open each one and copy the
# id from the URL: https://<instance>/home/credentials/<ID>
CRED_GEMINI=
CRED_AIRTABLE=
CRED_TELEGRAM_MANAGER=
CRED_TELEGRAM_SUPPORT=
CRED_GMAIL=
CRED_GDRIVE=

# --- n8n form triggers (WF6 / WF7) -----------------------------------------
# n8n serves each Form Trigger at /form/<trigger id>. Open the trigger node in n8n and copy the
# id from its "Production URL" (the part after /form/). load_rag.py posts the files there.
FORM_POLICIES_ID=
FORM_PRODUCTS_ID=

# --- Local n8n in Docker (docker-compose.yml) -------------------------------
# Only needed if you run n8n locally instead of n8n Cloud.
# Encrypts the credentials n8n stores. Generate once and keep it:
#   python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=
# Public HTTPS base URL with a trailing slash, e.g. https://n8n.example.com/
# Telegram triggers and the Lovable app cannot reach http://localhost. Empty = localhost only.
N8N_WEBHOOK_URL=
# 1 when n8n sits behind the Cloudflare tunnel, otherwise leave empty
N8N_PROXY_HOPS=
# Optional: pin an n8n image version (default: latest)
N8N_VERSION=
# Cloudflare Zero Trust -> Networks -> Tunnels -> create tunnel -> copy the token
# (used by: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
